 "lines": [
  {
   "id": "l01",
   "voice": "anlatici",
   "text": "Kasım. Gece etüdü. Okulda yedi öğrenci kaldı."
  },
  {
   "id": "l02",
   "voice": "anlatici",
   "text": "Nöbetçi hoca çıkarken, tek bir şey söyledi."
  },
  {
   "id": "l03",
   "voice": "hoca",
   "text": "Zil çalarsa... koridora sakın tek başınıza çıkmayın."
  },
  {
   "id": "l05",
   "voice": "anlatici",
   "text": "Okulun zili yıllardır çalmıyordu. Ta ki dokuzu kırk yedi geçeye kadar."
  },
  {
   "id": "l06",
   "voice": "bora",
   "text": "Bu kimin şakası ya?"
  },
  {
   "id": "l07",
   "voice": "ece",
   "text": "Telefonlar... hiçbirinde şebeke yok."
  },
  {
   "id": "l08",
   "voice": "kerem",
   "text": "Herkes sakin olsun. Kimse bir yere ayrılmıyor."
  },
  {
   "id": "l09",
   "voice": "anlatici",
   "text": "Pencerenin dışında şehir yoktu. Sadece sis."
  },
  {
   "id": "l10",
   "voice": "deniz",
   "text": "Orada biri var. Bahçe kapısının yanında... bir ışık."
  },
  {
   "id": "l11",
   "voice": "kerem",
   "text": "Deniz, dur. Kimse çıkmıyor dedim."
  },
  {
   "id": "l12",
   "voice": "deniz",
   "text": "İki dakika. Sadece bakıp geleceğim."
  },
  {
   "id": "l13",
   "voice": "anlatici",
   "text": "Deniz, ışığa doğru yürüdü. Ve ışıkla birlikte... kayboldu."
  },
  {
   "id": "l15",
   "voice": "anlatici",
   "text": "O anda, altısının telefonu aynı anda titredi. Mesaj, Deniz'dendi."
  },
  {
   "id": "l16",
   "voice": "deniz",
   "text": "Sakın kapıyı açmayın. Ben dışarıda değilim."
  },
  {
   "id": "l17",
   "voice": "anlatici",
   "text": "Mesajın tarihi: on dokuz Kasım... bin dokuz yüz seksen yedi."
  }
 ]
}